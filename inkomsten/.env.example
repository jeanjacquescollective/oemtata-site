# Kopieer naar .env en vul aan. .env wordt nooit gecommit.

# eb online login (gebruikersnaam + wachtwoord)
EB_USERNAME=
EB_PASSWORD=

# Pagina met de terminaltransacties
EB_MERCHANT_URL=https://www.ebonline.be/customer/merchants/166354/16635401

# PIN voor het beschermde detailscherm
DETAIL_PIN=1609

# Een cafédag loopt tot dit uur ('s ochtends). Transacties voor 06:00 tellen bij de vorige dag.
DAY_CUTOFF_HOUR=6

# Browser voor de downloader: msedge (standaard op Windows), chrome, of leeg voor de Playwright-Chromium
BROWSER_CHANNEL=msedge

# Sleutel voor de versleutelde transactielijst in store/ (ook als GitHub-secret instellen).
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORE_KEY=
